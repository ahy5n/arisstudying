# Leave both empty to run in "this device only" mode (progress saved in the browser).
# Fill them in (Supabase → Project Settings → API) to sync across devices.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Usernames are turned into {username}@{this domain} behind the scenes.
# Only change this if Supabase refuses the .local addresses.
NEXT_PUBLIC_USERNAME_EMAIL_DOMAIN=arisstudying.local
